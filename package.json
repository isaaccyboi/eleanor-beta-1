{
  "name": "eleanor",
  "version": "0.1.0-beta.1",
  "private": true,
  "type": "module",
  "description": "Eleanor by Dhozzi — a calm, composed AI companion for Gen X+ women, built on the Claude API and the same agent core as Chai-Kan.",
  "scripts": {
    "eleanor-api": "tsx src/eleanor-api-server.ts",
    "agent": "tsx src/index.ts",
    "web": "tsx src/web-cli.ts",
    "chaikan-api": "tsx src/api-server.ts",
    "build": "tsc",
    "start": "node dist/eleanor-api-server.js",
    "start:chaikan": "node dist/api-server.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "eval": "tsx src/eval-cli.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.0",
    "express": "^4.22.2",
    "fast-glob": "^3.3.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^22.14.0",
    "tsx": "^4.19.2",
    "typescript": "~5.8.2"
  },
  "engines": {
    "node": ">=20"
  }
}
